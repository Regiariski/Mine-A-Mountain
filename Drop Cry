	if isAutoDropRunning then
		Btn1.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		Btn1.Text = "Drop: ON"
		task.spawn(runAutoDrop)
	else
		Btn1.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		Btn1.Text = "Drop: OFF"
	end
end)

