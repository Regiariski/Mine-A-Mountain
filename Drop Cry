-- AUTO FAST MINE
local isFastMineRunning = false
local TWEEN_SPEED = 120 
local DETECTION_RADIUS = 50 
local BASE_HOVER_HEIGHT = 5 

local function getSafeHoverPosition(targetPart)
	local topOffset = (targetPart.Size.Y / 2) + BASE_HOVER_HEIGHT
	return targetPart.CFrame + Vector3.new(0, topOffset, 0)
end

local function tweenToFast(targetCFrame)
	local _, _, hrp, _ = getCharacterParts()
	local duration = (hrp.Position - targetCFrame.Position).Magnitude / TWEEN_SPEED
	local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
	tween:Play()
	tween.Completed:Wait()
end

local function getNearestNocturnitePart()
	local _, _, hrp, _ = getCharacterParts()
	if not hrp then return nil end
	local nearestPart = nil
	local shortestDistance = math.huge
	local noctFolder = Workspace:FindFirstChild("MountainDecorations") and Workspace.MountainDecorations:FindFirstChild("Boulders") and Workspace.MountainDecorations.Boulders:FindFirstChild("Nocturnite")
	if not noctFolder then return nil end

	local baseCell = noctFolder:FindFirstChild("Nocturnite_cell")
	if baseCell and baseCell:IsA("BasePart") then
		shortestDistance = (hrp.Position - baseCell.Position).Magnitude
		nearestPart = baseCell
	end

	for i = 1, 100 do
		local targetPart = noctFolder:FindFirstChild(string.format("Nocturnite_cell.%03d", i))
		if targetPart and targetPart:IsA("BasePart") then
			local dist = (hrp.Position - targetPart.Position).Magnitude
			if dist < shortestDistance then
				shortestDistance = dist
				nearestPart = targetPart
			end
		end
	end
	return nearestPart
end

local function farmSinglePartFast(partName, targetPart)
	local noctFolder = Workspace:FindFirstChild("MountainDecorations") and Workspace.MountainDecorations:FindFirstChild("Boulders") and Workspace.MountainDecorations.Boulders:FindFirstChild("Nocturnite")
	local digReq = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("DigRequest")

	while isFastMineRunning and targetPart and targetPart.Parent and targetPart:IsA("BasePart") do
		equipTerminusDig()
		local _, _, hrp, _ = getCharacterParts()
		local safeTargetCFrame = getSafeHoverPosition(targetPart)
		
		if (hrp.Position - targetPart.Position).Magnitude > DETECTION_RADIUS then
			tweenToFast(safeTargetCFrame)
		else
			hrp.CFrame = safeTargetCFrame
		end
		
		if digReq then
			digReq:FireServer("The Terminus", vector.create(targetPart.Position.X, targetPart.Position.Y, targetPart.Position.Z))
		end
		task.wait(0.3)
		
		targetPart = noctFolder and noctFolder:FindFirstChild(partName) or nil
	end
end

local function startAutoFarmFast()
	local noctFolder = Workspace:FindFirstChild("MountainDecorations") and Workspace.MountainDecorations:FindFirstChild("Boulders") and Workspace.MountainDecorations.Boulders:FindFirstChild("Nocturnite")
	while isFastMineRunning do
		if not noctFolder then break end
		local foundAny = false
		
		local baseCell = noctFolder:FindFirstChild("Nocturnite_cell")
		if baseCell and baseCell:IsA("BasePart") and isFastMineRunning then
			foundAny = true
			farmSinglePartFast("Nocturnite_cell", baseCell)
		end

		for i = 1, 100 do
			if not isFastMineRunning then break end
			local targetPart = noctfolder and noctfolder:FindFirstChild(string.format("Nocturnite_cell.%03d", i))
			if targetPart and targetPart:IsA("BasePart") and isFastMineRunning then
				foundAny = true
				farmSinglePartFast(string.format("Nocturnite_cell.%03d", i), targetPart)
			end
		end
		task.wait(foundAny and 1 or 3)
	end
end

local function fastMineAutomation()
	local digReq = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("DigRequest")
	local startTimeTween = tick()
	
	while isFastMineRunning and (tick() - startTimeTween < 5) do
		local elapsed = tick() - startTimeTween
		updateStatusBar(string.format("Tween Auto Dig: %.1fs", 5 - elapsed), elapsed / 5, Color3.fromRGB(200, 150, 50))
		pcall(function()
			equipTerminusDig()
			local targetPart = getNearestNocturnitePart()
			if targetPart then
				local _, _, hrp, _ = getCharacterParts()
				if (hrp.Position - targetPart.Position).Magnitude > DETECTION_RADIUS then
					tweenToFast(getSafeHoverPosition(targetPart))
				else
					hrp.CFrame = getSafeHoverPosition(targetPart)
				end
				if digReq then digReq:FireServer("The Terminus", vector.create(targetPart.Position.X, targetPart.Position.Y, targetPart.Position.Z)) end
			end
		end)
		task.wait(0.3)
	end
	
	if isFastMineRunning then
		updateStatusBar("Auto Farm: Running Sequence", 1, Color3.fromRGB(50, 200, 50))
		task.spawn(startAutoFarmFast)
		task.wait(8) 
	end
	
	if isFastMineRunning then
		local startTimeStatic = tick()
		while isFastMineRunning and (tick() - startTimeStatic < 5) do
			local elapsed = tick() - startTimeStatic
			updateStatusBar(string.format("Auto Dig (Static): %.1fs", 5 - elapsed), elapsed / 5, Color3.fromRGB(50, 150, 200))
			pcall(function()
				equipTerminusDig()
				local _, _, hrp, _ = getCharacterParts()
				if hrp and digReq then
					digReq:FireServer("The Terminus", vector.create(hrp.Position.X, hrp.Position.Y, hrp.Position.Z))
				end
			end)
			task.wait(0.3)
		end
		if isFastMineRunning then updateStatusBar("Auto Farm: Active", 1, Color3.fromRGB(50, 200, 50)) end
	end
end

