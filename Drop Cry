local function removeTerminusESP(crystal)
	local espFolder = crystal:FindFirstChild("TerminusESP")
	if espFolder then espFolder:Destroy() end
end

-- 6. FITUR ESP NOCTURNITE
local isEspNocturniteRunning = false

local function addNocturniteESPToModel(modelOrFolder)
	local primaryPart = modelOrFolder:IsA("Model") and modelOrFolder.PrimaryPart or modelOrFolder:FindFirstChildWhichIsA("BasePart")
	
	if primaryPart and not modelOrFolder:FindFirstChild("NocturniteESP") then
		local highlight = Instance.new("Highlight")
		highlight.Name = "NocturniteESP"
		highlight.Adornee = modelOrFolder
		highlight.FillColor = Color3.fromRGB(0, 170, 255)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.4
		highlight.OutlineTransparency = 0
		highlight.Parent = modelOrFolder

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "NocturniteTag"
		billboard.Adornee = primaryPart
		billboard.Size = UDim2.new(0, 120, 0, 50)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = math.huge

		local textLabel = Instance.new("TextLabel")
		textLabel.Size = UDim2.new(1, 0, 1, 0)
		textLabel.BackgroundTransparency = 1
		textLabel.Text = "Nocturnite"
		textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		textLabel.TextScaled = true
		textLabel.Font = Enum.Font.SourceSansBold
		textLabel.TextStrokeTransparency = 0
		textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		textLabel.Parent = billboard

		billboard.Parent = modelOrFolder
	end
end

local function removeNocturniteESPFromModel(modelOrFolder)
	if modelOrFolder:IsA("Instance") then
		local esp = modelOrFolder:FindFirstChild("NocturniteESP")
		if esp then esp:Destroy() end
		local tag = modelOrFolder:FindFirstChild("NocturniteTag")
		if tag then tag:Destroy() end
	end
end

RunService.RenderStepped:Connect(function()
	local droppedCrystals = Workspace:FindFirstChild("DroppedCrystals")
	if isEspTerminusRunning and droppedCrystals then
		for _, child in ipairs(droppedCrystals:GetChildren()) do
			addTerminusESP(child)
		end
	else
		if droppedCrystals then
			for _, child in ipairs(droppedCrystals:GetChildren()) do
				removeTerminusESP(child)
			end
		end
	end

	pcall(function()
		local bouldersFolder = Workspace:FindFirstChild("MountainDecorations") 
			and Workspace.MountainDecorations:FindFirstChild("Boulders") 
			and Workspace.MountainDecorations.Boulders:FindFirstChild("Nocturnite")
			
		if isEspNocturniteRunning and bouldersFolder then
			if bouldersFolder:IsA("Folder") then
				for _, child in ipairs(bouldersFolder:GetChildren()) do
					addNocturniteESPToModel(child)
				end
			else
				addNocturniteESPToModel(bouldersFolder)
			end
		else
			if bouldersFolder then
				if bouldersFolder:IsA("Folder") then
					for _, child in ipairs(bouldersFolder:GetChildren()) do
						removeNocturniteESPFromModel(child)
					end
				else
					removeNocturniteESPFromModel(bouldersFolder)
				end
			end
		end
	end)
end)

