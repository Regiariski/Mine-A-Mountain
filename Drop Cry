-- 4. FITUR ESP TERMINUS (Tombol ke-4)
local isEspRunning = false
local espConnections = {}

local function addESP(crystal)
	if not isEspRunning then return end
	
	pcall(function()
		local isTerminus = false
		if crystal:GetAttribute("Mutation") == "Terminus" then
			isTerminus = true
		end
		
		pcall(function()
			if crystal.Mutation == "Terminus" then
				isTerminus = true
			end
		end)

		if isTerminus and not crystal:FindFirstChild("TerminusESP") then
			local espFolder = Instance.new("Folder")
			espFolder.Name = "TerminusESP"
			espFolder.Parent = crystal

			local highlight = Instance.new("Highlight")
			highlight.Name = "HighlightESP"
			highlight.Adornee = crystal
			highlight.FillColor = Color3.fromRGB(255, 0, 0)
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.4
			highlight.OutlineTransparency = 0
			highlight.Parent = espFolder

			local billboard = Instance.new("BillboardGui")
			billboard.Name = "TextESP"
			billboard.Adornee = crystal
			billboard.Size = UDim2.new(0, 100, 0, 50)
			billboard.StudsOffset = Vector3.new(0, 2, 0)
			billboard.AlwaysOnTop = true

			local textLabel = Instance.new("TextLabel")
			textLabel.Size = UDim2.new(1, 0, 1, 0)
			textLabel.BackgroundTransparency = 1
			textLabel.Text = "TERMINUS"
			textLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
			textLabel.TextScaled = true
			textLabel.Font = Enum.Font.SourceSansBold
			textLabel.TextStrokeTransparency = 0
			textLabel.Parent = billboard

			billboard.Parent = espFolder
		end
	end)
end

local function removeESP()
	pcall(function()
		local droppedCrystals = workspace:FindFirstChild("DroppedCrystals")
		if droppedCrystals then
			for _, crystal in ipairs(droppedCrystals:GetChildren()) do
				local esp = crystal:FindFirstChild("TerminusESP")
				if esp then
					esp:Destroy()
				end
			end
		end
	end)
end

Btn4.MouseButton1Click:Connect(function()
	isEspRunning = not isEspRunning
	
	if isEspRunning then
		Btn4.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		Btn4.Text = "ESP: ON"
		
		local droppedCrystals = workspace:WaitForChild("DroppedCrystals", 5)
		if droppedCrystals then
			for _, child in ipairs(droppedCrystals:GetChildren()) do
				addESP(child)
			end
			
			table.insert(espConnections, droppedCrystals.ChildAdded:Connect(function(child)
				task.wait(0.5)
				addESP(child)
			end))
		end
	else
		Btn4.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		Btn4.Text = "ESP: OFF"
		
		for _, conn in ipairs(espConnections) do
			conn:Disconnect()
		end
		espConnections = {}
		removeESP()
	end
end)

