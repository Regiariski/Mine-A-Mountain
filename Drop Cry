-- CLEAR AREA
createActionButton(MiscPage, "Clear Area", function()
	pcall(function()
		local character = player.Character
		if not character or not character:FindFirstChild("HumanoidRootPart") then return end
		local rootPos = character.HumanoidRootPart.Position
		local radius = 30
		
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj:IsA("BasePart") and not obj:IsDescendantOf(character) then
				if (obj.Position - rootPos).Magnitude <= radius then
					if obj.Name:lower() ~= "terrain" and not obj.Anchored then
						obj:Destroy()
					end
				end
			end
		end
	end)
end)

-- AUTO DIG
local isAutoDigRunning = false
local autoDigContainer, autoDigBg, autoDigCircle = createToggleFeature(MiscPage, "Auto Dig")

local function getCharacterParts()
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid")
	local hrp = char:WaitForChild("HumanoidRootPart")
	local bp = player:WaitForChild("Backpack")
	return char, hum, hrp, bp
end

local function equipTerminusDig()
	local char, hum, _, bp = getCharacterParts()
	if char:FindFirstChild("The Terminus") then return end
	local tool = bp:FindFirstChild("The Terminus")
	if tool and tool:IsA("Tool") then
		hum:EquipTool(tool)
	end
end

task.spawn(function()
	while true do
		if isAutoDigRunning then
			pcall(function()
				equipTerminusDig()
				local _, _, hrp, _ = getCharacterParts()
				if hrp then
					local pos = hrp.Position
					ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DigRequest"):FireServer("The Terminus", vector.create(pos.X, pos.Y, pos.Z))
				end
			end)
		end
		task.wait(0.3)
	end
end)

